{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "Full-Stack MERN Expense Tracker Application",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
