# ==========================================
# Expense Tracker - Server Environment Configuration
# ==========================================

# Server Listening Port (MUST be 5050; ports 3000, 5173, and 5022 are strictly forbidden)
PORT=5050

# MongoDB Connection String (Local instance or MongoDB Atlas cluster URI)
MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker

# JSON Web Token Secret Key for signing and validating session tokens
JWT_SECRET=super_secret_jwt_key_for_development_12345!

# Frontend Client Origin URL for CORS configuration (Frontend runs on port 5180)
CLIENT_URL=http://localhost:5180

# Runtime Environment mode (development | test | production)
NODE_ENV=development
