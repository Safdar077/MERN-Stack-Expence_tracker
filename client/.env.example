# ==========================================
# Expense Tracker - Client Environment Configuration
# ==========================================
# In local development, the Vite dev server runs on http://localhost:5180
# and proxies '/api' requests to http://localhost:5050.
#
# Development default (uses Vite proxy):
VITE_API_BASE_URL=/api

# Production example (when backend is hosted separately, e.g. on Render):
# VITE_API_BASE_URL=https://expense-tracker-api.onrender.com/api

# Note:
# - Client MUST run on port 5180 (configured in vite.config.js).
# - Ports 3000, 5173, and 5022 are strictly forbidden.
